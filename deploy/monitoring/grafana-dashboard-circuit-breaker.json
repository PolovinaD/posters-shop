{
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "timeseries",
      "title": "Circuit Breaker State Transitions — Rate (transitions/min)",
      "description": "Rate of circuit breaker state transitions. Each spike indicates a transition event. closed→open means failures tripped the breaker; open→half_open means recovery probe started; half_open→closed means service recovered. Split by exported_service: the Prometheus scrape attaches its own `service` label (the Kubernetes Service, \"orders\"), so the application's service label — inventory or payments — surfaces as `exported_service`. If the legend shows an empty service name, change exported_service to service in this panel's query and legend.",
      "targets": [
        {
          "expr": "sum(rate(circuit_breaker_state_transitions_total{service=\"orders\"}[1m])) by (exported_service, from_state, to_state) * 60",
          "legendFormat": "{{exported_service}}: {{from_state}} → {{to_state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "palette-classic"},
          "min": 0,
          "custom": {"axisLabel": "Transitions per minute"}
        },
        "overrides": [
          {
            "matcher": {"id": "byRegexp", "options": ".*closed → open.*"},
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {"fill": "solid"}
              },
              {"id": "custom.lineWidth", "value": 2}
            ]
          },
          {
            "matcher": {"id": "byRegexp", "options": ".*open → half_open.*"},
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [12, 6]
                }
              },
              {"id": "custom.lineWidth", "value": 2}
            ]
          },
          {
            "matcher": {"id": "byRegexp", "options": ".*half_open → closed.*"},
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dot",
                  "dash": [0, 8]
                }
              },
              {"id": "custom.lineWidth", "value": 2}
            ]
          },
          {
            "matcher": {"id": "byRegexp", "options": ".*half_open → open.*"},
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [4, 4]
                }
              },
              {"id": "custom.lineWidth", "value": 2}
            ]
          }
        ]
      },
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 10}
    },
    {
      "type": "timeseries",
      "title": "Circuit Breaker Cumulative Transitions (Total Count)",
      "description": "Running total of circuit breaker transitions by type. Shows how many times the breaker has opened and closed over the session. Also split by pod, so a breaker that opens on one replica before the other is visible as two separate steps — the per-replica unevenness discussed in §8.3. Split by exported_service: the Prometheus scrape attaches its own `service` label (the Kubernetes Service, \"orders\"), so the application's service label — inventory or payments — surfaces as `exported_service`. If the legend shows an empty service name, change exported_service to service in this panel's query and legend.",
      "targets": [
        {
          "expr": "sum(circuit_breaker_state_transitions_total{service=\"orders\"}) by (exported_service, pod, from_state, to_state)",
          "legendFormat": "{{exported_service}} {{from_state}} → {{to_state}} @ {{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "palette-classic"},
          "min": 0,
          "custom": {"axisLabel": "Cumulative transitions"}
        },
        "overrides": [
          {
            "matcher": {"id": "byRegexp", "options": ".*closed → open.*"},
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {"fill": "solid"}
              },
              {"id": "custom.lineWidth", "value": 2}
            ]
          },
          {
            "matcher": {"id": "byRegexp", "options": ".*open → half_open.*"},
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [12, 6]
                }
              },
              {"id": "custom.lineWidth", "value": 2}
            ]
          },
          {
            "matcher": {"id": "byRegexp", "options": ".*half_open → closed.*"},
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dot",
                  "dash": [0, 8]
                }
              },
              {"id": "custom.lineWidth", "value": 2}
            ]
          },
          {
            "matcher": {"id": "byRegexp", "options": ".*half_open → open.*"},
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [4, 4]
                }
              },
              {"id": "custom.lineWidth", "value": 2}
            ]
          }
        ]
      },
      "gridPos": {"x": 0, "y": 10, "w": 12, "h": 10}
    },
    {
      "type": "stat",
      "title": "Total Opens (closed → open)",
      "description": "How many times the circuit has opened due to failures.",
      "targets": [
        {
          "expr": "sum(circuit_breaker_state_transitions_total{service=\"orders\", from_state=\"closed\", to_state=\"open\"})",
          "legendFormat": "Opens"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 5}
            ]
          }
        }
      },
      "gridPos": {"x": 12, "y": 10, "w": 6, "h": 5}
    },
    {
      "type": "stat",
      "title": "Total Recoveries (half_open → closed)",
      "description": "How many times the circuit has recovered and closed after probing.",
      "targets": [
        {
          "expr": "sum(circuit_breaker_state_transitions_total{service=\"orders\", from_state=\"half_open\", to_state=\"closed\"})",
          "legendFormat": "Recoveries"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null}
            ]
          }
        }
      },
      "gridPos": {"x": 18, "y": 10, "w": 6, "h": 5}
    },
    {
      "type": "stat",
      "title": "Total Re-opens (half_open → open)",
      "description": "How many times the probe failed and the circuit re-opened.",
      "targets": [
        {
          "expr": "sum(circuit_breaker_state_transitions_total{service=\"orders\", from_state=\"half_open\", to_state=\"open\"})",
          "legendFormat": "Re-opens"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1}
            ]
          }
        }
      },
      "gridPos": {"x": 12, "y": 15, "w": 12, "h": 5}
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["postershop", "resilience", "circuit-breaker"],
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "browser",
  "title": "PosterShop Circuit Breaker State Transitions",
  "uid": "postershop-circuit-breaker",
  "version": 1
}
