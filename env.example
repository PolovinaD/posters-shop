# ============================================================
# PosterShop Platform - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp env.example .env
# ============================================================

# =========================
# AWS Configuration
# =========================
AWS_PROFILE=private
AWS_ACCOUNT_ID=123456789012
AWS_REGION=eu-north-1

# Derived values (auto-computed if not set)
# ECR_REGISTRY=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com

# =========================
# Kubernetes / EKS
# =========================
CLUSTER_NAME=postershop
NAMESPACE=postershop

# =========================
# Database (Local Development)
# =========================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=posters_shop

# Service-specific database URLs (for docker-compose)
# These use the schema-per-service pattern
USERS_DATABASE_URL=postgresql://users_svc:users_pass@db:5432/posters_shop
CATALOG_DATABASE_URL=postgresql://catalog_svc:catalog_pass@db:5432/posters_shop
ORDERS_DATABASE_URL=postgresql://orders_svc:orders_pass@db:5432/posters_shop
PRODUCTION_DATABASE_URL=postgresql://production_svc:production_pass@db:5432/posters_shop
LOGISTICS_DATABASE_URL=postgresql://logistics_svc:logistics_pass@db:5432/posters_shop
INVENTORY_DATABASE_URL=postgresql://inventory_svc:inventory_pass@db:5432/posters_shop

# =========================
# Authentication
# =========================
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# =========================
# CORS
# =========================
CORS_ORIGINS=http://localhost:3000

# =========================
# Circuit Breaker
# =========================
CB_FAILURE_THRESHOLD=5
CB_RECOVERY_TIMEOUT=30

# =========================
# Stripe (test mode)
# =========================
# Test mode keys from Stripe Dashboard → Developers → API keys (sk_test_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_test_secret_key_12345

# =========================
# Ethereum escrow (Ganache simulator)
# =========================
# Owner key that deploys/binds/releases OrderEscrow contracts. Compose ships a fixed dev key; in EKS it
# comes from Secrets Manager postershop/escrow (OWNER_PRIVATE_KEY). Never rotate it while orders are in flight.
ESCROW_OWNER_PRIVATE_KEY=0x4c0883a69102937d6231471b5dbb6204fe5129617082792ae468d01a3f362318
# RPC the browser uses (proxied by nginx/vite to ganache:8545)
ESCROW_PUBLIC_RPC_URL=/rpc
# Fixed conversion: 0.001 ETH per USD
WEI_PER_USD=1000000000000000
# Courier share of the escrowed amount in basis points (2000 = 20 %)
ESCROW_COURIER_SHARE_BPS=2000
# Top the owner up from Ganache account 0 when below this many ETH
ESCROW_OWNER_MIN_BALANCE_ETH=10
# Serve the deterministic Ganache keys at /v1/escrow/demo-accounts (only ever on Ganache)
ESCROW_EXPOSE_DEMO_ACCOUNTS=true
# Orders reconciler poll (seconds)
ESCROW_RECONCILE_INTERVAL=15
# Wallet the auto-advance worker binds on pick-up (Ganache account[2]); unset => no courier bound unattended
LOGISTICS_DEFAULT_COURIER_WALLET=0x22d491bde2303f2f43325b2108d26f1eaba1e32b

# =========================
# AI Poster Studio (designs service)
# =========================
# IMAGE_PROVIDER: fake (default, Pillow placeholder, no key) | openai | replicate
IMAGE_PROVIDER=fake
# OpenAI: Images API for posters (gpt-image-1.5 / medium ≈ $0.06 per 1024x1536 PNG) and Chat for the style profile
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_QUALITY=medium
OPENAI_CHAT_MODEL=gpt-4o-mini
# Replicate (serverless GPU): built and unit-tested, no token available yet
REPLICATE_API_TOKEN=
REPLICATE_MODEL=black-forest-labs/flux-schnell
# Per-user daily generation limit (owner exempt), print-on-demand price ladder base and virtual stock
AI_DAILY_QUOTA=10
AI_POSTER_BASE_PRICE=29.99
AI_POSTER_STOCK=1000
# Worker: poll interval (s) and provider attempts before a generation fails
DESIGNS_WORKER_POLL_INTERVAL=1.0
DESIGNS_MAX_ATTEMPTS=3
# Storage: local (compose volume designs-data) | s3 (EKS, IRSA); bucket/region only for s3
# STORAGE_BACKEND=local
# DESIGNS_S3_BUCKET=
# DESIGNS_S3_REGION=eu-north-1

# =========================
# GitHub Actions (for reference)
# =========================
# Set these as repository variables in GitHub:
# - AWS_ACCOUNT_ID
# - AWS_REGION  
# - EKS_CLUSTER
#
# Set these as repository secrets in GitHub:
# - (OIDC handles authentication, no secrets needed for AWS)

# =========================
# Service URLs (for inter-service communication)
# =========================
INVENTORY_SERVICE_URL=http://inventory:8000
PRODUCTION_SERVICE_URL=http://production:8000
LOGISTICS_SERVICE_URL=http://logistics:8000
ORDERS_SERVICE_URL=http://orders:8000
PAYMENT_SERVICE_URL=http://payments:8000
NOTIFICATIONS_SERVICE_URL=http://notifications:8000

# =========================
# Notifications (Email)
# =========================
# Local dev uses the logging provider (no AWS needed). Set to "ses" in prod.
EMAIL_PROVIDER=logging
EMAIL_FROM=no-reply@postershop.local
# Region where EMAIL_FROM is a verified SES sender (prod cluster runs in eu-north-1)
SES_REGION=eu-central-1

